{
  "source_encoding": "cp1252",
  "pascal_extensions": [".pas", ".dfm", ".dpr", ".inc"],
  "protected_extensions": [".pas", ".dfm", ".dpr", ".dproj", ".inc", ".py", ".md"],
  "forbid_inline_python": true,
  "forbid_gh_write": true,
  "scripts_dir": "scripts/",
  "write_db_users": ["app_owner"],
  "signature_pattern": "[A-Z]{2,4} - {date}",
  "date_format": "%Y-%m-%d",
  "measure_marker": "X-MEASURE",
  "dead_code_marker": "DEAD-CODE",
  "warn_binary_dfm": true,
  "forbidden_patterns": []
}
